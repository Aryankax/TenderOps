{
  "openapi": "3.1.0",
  "info": {
    "title": "TenderOps API",
    "description": "Two-agent tender pipeline: the Tender Analyst Agent extracts structured requirements from GeM tender PDFs, and the Evidence Agent maps each requirement against indexed company documents.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/tender-analysis": {
      "post": {
        "tags": [
          "Tender Analysis"
        ],
        "summary": "Analyze tender PDF",
        "description": "Upload a GeM tender PDF (max 10 MB). Returns structured metadata, per-chunk requirements with normalized thresholds, cross-chunk issues (missing attachments, contradictions), and review flags.",
        "operationId": "analyze_tender_api_tender_analysis_post",
        "parameters": [
          {
            "name": "fetch_links",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Follow embedded links/attachments (annexures) into the analysis.",
              "default": true,
              "title": "Fetch Links"
            },
            "description": "Follow embedded links/attachments (annexures) into the analysis."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_analyze_tender_api_tender_analysis_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenderAnalysisResult"
                }
              }
            }
          },
          "400": {
            "description": "Not a PDF, file too large, or PDF unparseable."
          },
          "500": {
            "description": "Analysis pipeline failure."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/pipeline/run": {
      "post": {
        "tags": [
          "Pipeline"
        ],
        "summary": "Run full pipeline (P1+P2+P3+P4)",
        "description": "Upload a tender PDF: supervised run of tender analysis (P1, incl. linked annexures), evidence mapping (P2), compliance + blockers (P3), then bid drafting with independent verification (P4, bounded fix loop). Pauses with a checkpoint when blockers need human fixes; resume via POST /api/pipeline/resume or run async via jobs.",
        "operationId": "run_pipeline_api_pipeline_run_post",
        "parameters": [
          {
            "name": "fetch_links",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Follow embedded links/attachments (annexures) into the analysis.",
              "default": true,
              "title": "Fetch Links"
            },
            "description": "Follow embedded links/attachments (annexures) into the analysis."
          },
          {
            "name": "company_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Company profile: evidence is searched strictly inside this company's index.",
              "default": "sample",
              "title": "Company Id"
            },
            "description": "Company profile: evidence is searched strictly inside this company's index."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_run_pipeline_api_pipeline_run_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PipelineResult"
                }
              }
            }
          },
          "400": {
            "description": "Not a PDF, file too large, or PDF unparseable."
          },
          "500": {
            "description": "Analysis, evidence-mapping or compliance failure."
          },
          "404": {
            "description": "Unknown tender_id (resume only)."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/pipeline/resume": {
      "post": {
        "tags": [
          "Pipeline"
        ],
        "summary": "Resume a paused pipeline",
        "description": "Reload a checkpoint by tender_id, optionally with additional company PDFs (appended to the evidence index), then re-run only affected checks (missing/review/partial requirements + blocker-linked ones) before a fresh compliance pass.",
        "operationId": "resume_pipeline_api_pipeline_resume_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_resume_pipeline_api_pipeline_resume_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PipelineResult"
                }
              }
            }
          },
          "400": {
            "description": "No usable PDFs in the fix upload."
          },
          "404": {
            "description": "Unknown tender_id (no checkpoint)."
          },
          "500": {
            "description": "Resume failure."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/pipeline/evidence-index": {
      "get": {
        "tags": [
          "Pipeline"
        ],
        "summary": "List indexed company documents",
        "description": "Inventory of a company's evidence index: which documents are indexed, with chunk and page counts. Use company_id to inspect one company's private index.",
        "operationId": "list_evidence_index_api_pipeline_evidence_index_get",
        "parameters": [
          {
            "name": "company_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "sample",
              "title": "Company Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Empty files list when nothing indexed.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Pipeline"
        ],
        "summary": "Rebuild company evidence index",
        "description": "Upload company PDFs (turnover/experience/OEM certificates, \u2026) either as individual `files` or as a single `zip_file` containing many PDFs (the zip is unpacked server-side, non-PDF members skipped). Replaces the 'sample' evidence collection used by P2 mapping.",
        "operationId": "rebuild_evidence_index_api_pipeline_evidence_index_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "No usable PDFs (wrong type, bad zip, or all skipped)."
          }
        },
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "files": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    },
                    "description": "Individual company PDFs (repeatable)."
                  },
                  "zip_file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Zip archive of company PDFs."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs": {
      "post": {
        "tags": [
          "Jobs"
        ],
        "summary": "Start async pipeline run",
        "description": "Stores the tender PDF and runs the full supervised pipeline (P1+P2+P3+P4) in a background worker. Poll GET /api/jobs/{job_id} for the outcome \u2014 no long-lived HTTP connection needed.",
        "operationId": "start_job_api_jobs_post",
        "parameters": [
          {
            "name": "fetch_links",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true,
              "title": "Fetch Links"
            }
          },
          {
            "name": "company_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Company profile: evidence is searched strictly inside this company's index.",
              "default": "sample",
              "title": "Company Id"
            },
            "description": "Company profile: evidence is searched strictly inside this company's index."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_start_job_api_jobs_post"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Not a PDF or file too large."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Jobs"
        ],
        "summary": "List recent jobs",
        "operationId": "list_jobs_api_jobs_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Newest first.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/jobs/{job_id}": {
      "get": {
        "tags": [
          "Jobs"
        ],
        "summary": "Poll job status / result",
        "operationId": "get_job_api_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Includes result once DONE.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Unknown job_id."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/stream": {
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "Live agent event stream (SSE)",
        "description": "Server-sent events of agent activity: node starts/successes, retries, provider fallbacks, blockers. Filter by tender_id (matches tender_id or run_id). Replay recent history first, then stream live. Clients reconnect with ?after=<last seq>.",
        "operationId": "stream_events_api_events_stream_get",
        "parameters": [
          {
            "name": "tender_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tender Id"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "After"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "text/event-stream",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BidDraft": {
        "properties": {
          "draft_id": {
            "type": "string",
            "title": "Draft Id"
          },
          "requirement_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requirement Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind",
            "default": "requirement_response"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "body": {
            "type": "string",
            "title": "Body"
          },
          "evidence_refs": {
            "items": {
              "$ref": "#/components/schemas/EvidenceRef"
            },
            "type": "array",
            "title": "Evidence Refs"
          },
          "claimed_value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Claimed Value"
          },
          "claimed_unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Claimed Unit"
          },
          "needs_human_signoff": {
            "type": "boolean",
            "title": "Needs Human Signoff",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "draft_id",
          "title",
          "body"
        ],
        "title": "BidDraft",
        "description": "One draft artifact. Grounded by construction: every draft cites the\nevidence it rests on, and numeric claims travel as structured fields\nso the verifier can re-check them without parsing prose."
      },
      "BidPackage": {
        "properties": {
          "tender_id": {
            "type": "string",
            "title": "Tender Id"
          },
          "drafts": {
            "items": {
              "$ref": "#/components/schemas/BidDraft"
            },
            "type": "array",
            "title": "Drafts"
          },
          "checklist": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Checklist"
          },
          "risk_report": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Risk Report"
          }
        },
        "type": "object",
        "required": [
          "tender_id"
        ],
        "title": "BidPackage"
      },
      "Blocker": {
        "properties": {
          "blocker_id": {
            "type": "string",
            "title": "Blocker Id"
          },
          "blocker_type": {
            "$ref": "#/components/schemas/BlockerType"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "severity": {
            "type": "string",
            "title": "Severity",
            "default": "high"
          },
          "affected_requirement_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Affected Requirement Ids"
          },
          "resolution_hint": {
            "type": "string",
            "title": "Resolution Hint",
            "default": ""
          },
          "requires_human_review": {
            "type": "boolean",
            "title": "Requires Human Review",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "blocker_id",
          "blocker_type",
          "description"
        ],
        "title": "Blocker"
      },
      "BlockerType": {
        "type": "string",
        "enum": [
          "MISSING_DOCUMENT",
          "FAILED_CHECK",
          "EXPIRED_DOCUMENT",
          "CONTRADICTION",
          "UNRESOLVED_REVIEW",
          "INCOMPLETE_EVIDENCE"
        ],
        "title": "BlockerType"
      },
      "Body_analyze_tender_api_tender_analysis_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_analyze_tender_api_tender_analysis_post"
      },
      "Body_resume_pipeline_api_pipeline_resume_post": {
        "properties": {
          "tender_id": {
            "type": "string",
            "title": "Tender Id"
          },
          "files": {
            "anyOf": [
              {
                "items": {
                  "type": "string",
                  "contentMediaType": "application/octet-stream"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Files"
          },
          "zip_file": {
            "anyOf": [
              {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Zip File"
          },
          "company_id": {
            "type": "string",
            "title": "Company Id",
            "default": "sample"
          },
          "waive": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Waive",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "tender_id"
        ],
        "title": "Body_resume_pipeline_api_pipeline_resume_post"
      },
      "Body_run_pipeline_api_pipeline_run_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_run_pipeline_api_pipeline_run_post"
      },
      "Body_start_job_api_jobs_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_start_job_api_jobs_post"
      },
      "ComplianceMatrix": {
        "properties": {
          "tender_id": {
            "type": "string",
            "title": "Tender Id"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/RequirementCompliance"
            },
            "type": "array",
            "title": "Items"
          },
          "blockers": {
            "items": {
              "$ref": "#/components/schemas/Blocker"
            },
            "type": "array",
            "title": "Blockers"
          },
          "waived_blockers": {
            "items": {
              "$ref": "#/components/schemas/Blocker"
            },
            "type": "array",
            "title": "Waived Blockers"
          },
          "summary": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Summary"
          },
          "decision": {
            "type": "string",
            "title": "Decision",
            "default": "PROCEED"
          }
        },
        "type": "object",
        "required": [
          "tender_id"
        ],
        "title": "ComplianceMatrix"
      },
      "ComplianceStatus": {
        "type": "string",
        "enum": [
          "COMPLIANT",
          "NON_COMPLIANT",
          "PENDING",
          "NEEDS_REVIEW"
        ],
        "title": "ComplianceStatus",
        "description": "The four terminal states from the P3 plan (plain Python, no LLM)."
      },
      "EvidenceHit": {
        "properties": {
          "document_name": {
            "type": "string",
            "title": "Document Name"
          },
          "page_number": {
            "type": "integer",
            "title": "Page Number"
          },
          "excerpt": {
            "type": "string",
            "title": "Excerpt"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "supports": {
            "type": "string",
            "title": "Supports",
            "default": "supports"
          }
        },
        "type": "object",
        "required": [
          "document_name",
          "page_number",
          "excerpt",
          "score"
        ],
        "title": "EvidenceHit"
      },
      "EvidenceMap": {
        "properties": {
          "tender_id": {
            "type": "string",
            "title": "Tender Id"
          },
          "company_profile_id": {
            "type": "string",
            "title": "Company Profile Id",
            "default": "sample"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/RequirementEvidence"
            },
            "type": "array",
            "title": "Items"
          },
          "unmapped_requirements": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Unmapped Requirements"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "type": "object",
        "required": [
          "tender_id"
        ],
        "title": "EvidenceMap"
      },
      "EvidenceRef": {
        "properties": {
          "document_name": {
            "type": "string",
            "title": "Document Name"
          },
          "page_number": {
            "type": "integer",
            "title": "Page Number"
          }
        },
        "type": "object",
        "required": [
          "document_name",
          "page_number"
        ],
        "title": "EvidenceRef"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PipelineResult": {
        "properties": {
          "tender_id": {
            "type": "string",
            "title": "Tender Id"
          },
          "analysis": {
            "$ref": "#/components/schemas/TenderAnalysisResult"
          },
          "evidence": {
            "$ref": "#/components/schemas/EvidenceMap"
          },
          "compliance": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ComplianceMatrix"
              },
              {
                "type": "null"
              }
            ]
          },
          "package": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/BidPackage"
              },
              {
                "type": "null"
              }
            ]
          },
          "verification": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VerificationReport"
              },
              {
                "type": "null"
              }
            ]
          },
          "pipeline_status": {
            "type": "string",
            "title": "Pipeline Status",
            "default": "COMPLETED"
          },
          "checkpoint_path": {
            "anyOf": [
              {
                "type": "string"

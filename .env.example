# Copy to .env and fill in your keys. Never commit .env.
# Required: primary LLM gateway.
LITELLM_API_KEY=
# Optional overrides (defaults shown in app/core/config.py).
# LITELLM_BASE_URL=https://litellm.vision.aivar.app/v1
# LITELLM_MODEL=claude-haiku
# Fallback provider when the gateway is over limit or down.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# Observability: required for neatlogs traces (app runs without it, untraced).
NEATLOGS_API_KEY=
